{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/vault.ts",
    "src/crypto.ts",
    "src/recovery.ts",
    "src/did.ts",
    "src/consent.ts",
    "src/sharing.ts",
    "src/audit.ts",
    "src/form-filler.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
